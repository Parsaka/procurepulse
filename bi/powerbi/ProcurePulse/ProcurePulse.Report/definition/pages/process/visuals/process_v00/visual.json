{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "process_v00",
  "position": {
    "x": 20,
    "y": 20,
    "z": 0,
    "width": 1240,
    "height": 330,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_date"
                    }
                  },
                  "Property": "month_start"
                }
              },
              "queryRef": "dim_date.month_start",
              "nativeQueryRef": "month_start"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "KPIs"
                    }
                  },
                  "Property": "Conformance Rate"
                }
              },
              "queryRef": "KPIs.Conformance Rate",
              "nativeQueryRef": "Conformance Rate"
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fct_po_item"
                    }
                  },
                  "Property": "item_category"
                }
              },
              "queryRef": "fct_po_item.item_category",
              "nativeQueryRef": "item_category"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Conformance rate by PO month and item category'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
